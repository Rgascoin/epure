{
  "name": "epure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm recipes:index && next dev",
    "build": "pnpm recipes:index && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm recipes:index && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "recipes:index": "node scripts/generate-recipe-index.mjs",
    "recipes:images": "node scripts/recipe-images.mjs",
    "recipes:check": "pnpm recipes:index && vitest run tests/recipes.test.ts",
    "test": "pnpm recipes:index && vitest run",
    "recipes:photos": "node scripts/photo-search.mjs",
    "recipes:new": "node scripts/new-recipe.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "recipes:todo": "node scripts/backlog.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
